// Cloudflare Pages config for the CGC Darts shop at shop.aadsdarts.com.
// Deploy: `npm run build:shop && npx wrangler pages deploy`. Pages serves
// index.html for unknown paths (/admin, /custom-order/<token>, …) because
// the build has no 404.html, which gives client-side routing.
{
  "name": "cgc-shop",
  "pages_build_output_dir": "./dist-shop",
  "compatibility_date": "2026-09-01"
}
